/* =============================================
   NETWORK SCREEN
   ============================================= */

Network {
    background: #050010;
    overflow-y: auto;
}

/* Banner diagram */
#network-banner {
    color: #7c3aed;
    text-align: center;
    padding: 1 2 0 2;
    text-style: bold;
    width: 100%;
}

#network-tagline {
    color: #3b0764;
    text-align: center;
    padding: 0 2 1 2;
    width: 100%;
}

/* Host / Join card row */
#mode-row {
    width: 100%;
    padding: 1 3;
    height: auto;
}

/* Individual cards */
#host-card {
    width: 1fr;
    border: solid #2d1b69;
    padding: 1 2;
    margin: 0 2 0 0;
    background: #0a0018;
    height: auto;
}

#join-card {
    width: 1fr;
    border: solid #2d1b69;
    padding: 1 2;
    margin: 0 0 0 2;
    background: #0a0018;
    height: auto;
}

#host-card:hover {
    border: solid #6d28d9;
}

#join-card:hover {
    border: solid #6d28d9;
}

/* Card text */
.mode-label {
    color: #c084fc;
    text-style: bold;
    text-align: center;
    width: 100%;
    padding: 0 0 1 0;
}

.mode-desc {
    color: #4c1d95;
    text-align: center;
    width: 100%;
    padding: 0 0 1 0;
}

/* Buttons inside cards stretch full width */
#host-card Button {
    width: 100%;
    height: 5;
    min-width: 1;
    margin-right: 0;
    padding: 1 2;
}

#join-card Button {
    width: 100%;
    height: 5;
    min-width: 1;
    margin-right: 0;
    padding: 1 2;
}

/* Network input / labels */
Network Input {
    margin: 1 3;
}

Network Label {
    padding: 1 3;
    color: #a855f7;
}

/* Network action buttons row */
#network-action-buttons {
    padding: 1 3;
    height: auto;
}

#network-action-buttons Button {
    height: 5;
    padding: 1 4;
    min-width: 16;
}

/* Received content label */
#received-header {
    color: #3b0764;
    padding: 1 3 0 3;
    text-style: bold;
    width: 100%;
}

/* Markdown pane in network (received file view) */
Network Markdown {
    height: 15;
    margin: 0 3 1 3;
    padding: 0 1;
    border: solid #2d1b69;
    background: #030008;
    color: #d8b4fe;
}

/* =============================================
