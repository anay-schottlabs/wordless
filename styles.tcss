/* =============================================
   WORDLESS  —  RETRO PURPLE / HACKER THEME
   ============================================= */

/* I had the UI done through AI */

/* ---- Root ---- */
Screen {
    background: #050010;
    color: #e9d5ff;
}

/* ---- Header ---- */
Header {
    background: #0d0020;
    color: #c084fc;
    text-style: bold;
    border-bottom: solid #3b0764;
}

HeaderTitle {
    color: #c084fc;
    text-style: bold;
}

HeaderIcon {
    color: #7c3aed;
}

/* ---- Footer ---- */
Footer {
    background: #0d0020;
    color: #7c3aed;
    border-top: solid #2d1b69;
}

FooterKey {
    color: #a855f7;
    background: #1a0035;
}

FooterKey .footer-key--key {
    color: #c084fc;
    background: #3b0764;
}

/* ---- Tab Bar ---- */
Tabs {
    background: #0a0018;
    border-bottom: solid #2d1b69;
}

Tab {
    background: #0a0018;
    color: #6d28d9;
    padding: 0 2;
}

Tab:hover {
    background: #1a0035;
    color: #c084fc;
}

Tab.-active {
    background: #3b0764;
    color: #e9d5ff;
    text-style: bold;
}

Tab.-active:hover {
    background: #4c0a7e;
}

